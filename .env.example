# PostgreSQL is the normal application database.
POSTGRES_DB=household_split
POSTGRES_USER=household_split
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Europe/Berlin

# Tests can set this to 1 when PostgreSQL is not running.
USE_SQLITE=0
